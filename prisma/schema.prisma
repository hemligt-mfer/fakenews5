generator client {
    provider        = "prisma-client"
    output          = "../src/generated/prisma"
    previewFeatures = ["relationJoins"]
}

datasource db {
    provider = "postgresql"
}

model User {
    id            String    @id
    name          String
    email         String
    emailVerified Boolean   @default(false)
    image         String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    role          String?
    banned        Boolean?  @default(false)
    banReason     String?
    banExpires    DateTime?
    sessions      Session[]
    accounts      Account[]
    user_info     UserInfo?
    author        Author?

    @@unique([email])
    @@map("user")
}

model Session {
    id             String   @id
    expiresAt      DateTime
    token          String
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    ipAddress      String?
    userAgent      String?
    userId         String
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    impersonatedBy String?

    @@unique([token])
    @@index([userId])
    @@map("session")
}

model Account {
    id                    String    @id
    accountId             String
    providerId            String
    userId                String
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    scope                 String?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @default(now())

    @@index([userId])
    @@map("account")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}

model Article {
    id            String            @id @default(ulid())
    title         String
    summary       String?
    content       String
    views         ArticleView[]
    reactions     ArticleReaction[]
    image         String?
    createdAt     DateTime          @default(now()) @map("created_at")
    updatedAt     DateTime          @default(now()) @map("updated_at")
    category      Category[]
    location      String?
    author        Author[]
    bookmark      Bookmark[]
    comments      Comment[]
    editorsChoice Boolean           @default(false)
    deleted       DateTime?

    @@map("article")
}

model Comment {
    id        String            @id @default(ulid())
    articleId String            @map("article_id")
    article   Article           @relation(fields: [articleId], references: [id])
    user_id   String
    user      UserInfo          @relation(fields: [user_id], references: [id])
    content   String
    reactions CommentReaction[]
    createdAt DateTime
    updatedAt DateTime
    replyTo   String?           @map("reply_to") // Stores a comment id to which the comment in questions is a reply
}

model CommentReaction {
    id        String  @id @default(ulid())
    userId    String  @unique
    commentId String  @unique
    comment   Comment @relation(fields: [commentId], references: [id])
    val       Int     @default(1)
}

model Bookmark {
    id        String   @id @default(ulid())
    user_id   String
    user      UserInfo @relation(fields: [user_id], references: [id])
    article   Article  @relation(fields: [articleId], references: [id])
    articleId String

    @@map("bookmark")
}

model ArticleView {
    id        String  @id @default(ulid())
    userId    String
    articleId String
    article   Article @relation(fields: [articleId], references: [id])
}

model Category {
    id      String    @id @default(ulid())
    name    String    @unique
    article Article[]

    @@map("category")
}

model Author {
    id        String    @id @default(ulid())
    alias     String    @unique
    userId    String    @unique @map("user_id")
    articles  Article[]
    user_info User      @relation(fields: [userId], references: [id])

    @@map("author")
}

model UserInfo {
    id          String     @id @default(ulid())
    userId      String     @unique @map("user_id")
    user        User       @relation(fields: [userId], references: [id])
    phoneNumber String?    @map("phone_number")
    address_id  String
    address     Address    @relation(fields: [address_id], references: [id])
    birthdate   DateTime
    role        Role       @default(UNSUBSCRIBED)
    bookmark    Bookmark[]
    comments    Comment[]

    @@map("user_info")
}

model ArticleReaction {
    id         String  @id @default(ulid())
    userId     String  @unique
    article_id String
    article    Article @relation(fields: [article_id], references: [id])
    val        Int     @default(1)

    @@map("article_reaction")
}

model Address {
    id        String     @id @default(ulid())
    street    String
    city      String
    country   String
    zip       String
    userInfos UserInfo[]

    @@map("address")
}

enum Role {
    UNSUBSCRIBED
    SUBSCRIBER
    AUTHOR
    EDITOR
    ADMIN
}
